@model InfinytraWebsite.Models.Member

@{
    ViewData["Title"] = Model?.Name ?? "Member";
}

<div class="container py-4">
   

    <div class="card p-3 detailsbackcard">
        <div class="d-flex gap-3 align-items-start">
            <img src="@(string.IsNullOrWhiteSpace(Model.PhotoURL) ? Url.Content("~/images/placeholder.png") : Url.Content(Model.PhotoURL))"
                 alt="@Model.Name" class="img-thumbnail" style="width:140px; height:140px; object-fit:cover; color:white;" />
            <div>
                <h2 style="color:white; text-shadow: 5px 2px purple; ">@Model.Name</h2>
                <p class="" style="color:white; text-shadow: 5px 2px purple;">Instrument: @Model.Instrument</p>
                <p style="color:white; text-shadow: 5px 2px purple;">Description: @Model.Description</p>

                <img src="@(string.IsNullOrWhiteSpace(Model.ImageURL) ? Url.Content("~/images/placeholder.png") : Url.Content(Model.ImageURL))" style="width: 300px" />

                <div class="mt-3">
                  @*   <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-secondary">Edit</a> *@
                   @*  <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-danger">Delete</a> *@


                    <a asp-action="Index" class="btn-back-neon">
                        ← Back to Members
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
