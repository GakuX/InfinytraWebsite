@model dynamic


@{
    ViewData["Title"] = "Index";
}

<div class="container py-4 text-white">
    <h1>Your Cart (@Model.Count) </h1>


    <a asp-controller="Merches" asp-action="Index"><span class="btn btn-danger text-white">Continue shopping?</span> </a>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-dark mt-3">
            Cart is empty.
        </div>
    }
    else
    {
        <div class="mt-3">
            @foreach (var item in Model)
            {
                <div class="card mb-3 p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div style="padding-top:10px">
                            <strong style="padding-top:10px">@item.Merch.ItemName</strong><br />
                            Qty: @item.Qty
                        </div>
                        <div>
                            
                            @{
                                decimal unit = item.Merch.Price;

                                if (item.Merch.OnSale && item.Merch.SalePrice > 0)
                                {
                                    unit = item.Merch.SalePrice;
                                }

                                decimal line = unit * item.Qty;
                            }
                            <div style="font-weight:bold; font-size:20px">Total: $@line</div>
                          
                        </div>
                    </div>
                    <div style="padding-top:20px">

                        <form asp-controller="Carts" asp-action="RemoveItem" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Merch.Id" />
                            <button type="submit" class="btn btn-danger">Remove</button>
                        </form>
                    </div>
                    
                </div>
            }
        </div>

        <div class="container-fluid" style="background-color:white">



            <h3 class="text-black" style="font-weight:bold">YOUR SUBTOTAL: $@ViewBag.Total</h3>

            <div>
                <span class="text-dark"> <a class="btn btn-light" style="border-color:black" asp-controller="Merches" asp-action="Index">Keep shopping</a></span>

                <span style="padding-left:20px"><a class="btn btn-dark" style="border-color:white" asp-controller="Merches" asp-action="Index">CHECKOUT</a></span>

               

            </div>
       

        </div>
     
    }
</div>