@model IEnumerable<InfinytraWebsite.Models.Album>

@{
    ViewData["Title"] = "Albums";
}


<div class="albumBackground">

    <h1 class="text-center text-dark mb-4">Albums</h1>

    <div class="d-flex justify-content-center mb-3">
        <a asp-action="Create" class="btn bg-black" style="color: white">+ Add New Album</a>
    </div>

    <div class="row">
        @foreach (var album in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm" style="background-color: #1b001b; color: white;">
                    <img src="@album.ImageURL" class="card-img-top" alt="@album.Title" style="height: 250px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@album.Title</h5>
                        <p class="card-text">@album.Description</p>
                        <p class="text-muted">Released: @album.CreatedDate</p>
                    </div>
                    <div class="card-footer text-center">
                        <a asp-action="Details" asp-route-id="@album.Id" class="btn btn-sm btn-light">View</a>
                        <a asp-action="Edit" asp-route-id="@album.Id" class="btn btn-sm btn-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@album.Id" class="btn btn-sm btn-danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>


</div>


