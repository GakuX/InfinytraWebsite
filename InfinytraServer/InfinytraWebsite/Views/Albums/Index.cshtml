@model IEnumerable<InfinytraWebsite.Models.Album>

@{
    ViewData["Title"] = "Albums";
}


<div class="albumBackground">

    <h1 class="text-center text-dark mb-4">Albums</h1>

    <div class="d-flex justify-content-center mb-3">
        @* <a asp-action="Create" class="btn bg-black" style="color: white">+ Add New Album</a> *@
    </div>



    <form asp-action="Index" method="get" class="mb-4">
        <div class="row d-flex justify-content-center">
            <div class="col-md-4" style="height: 50px;">
                <div class="input-group">
                    <input type="text"
                           name="name"
                           class="form-control"
                           placeholder="Search by album name..."
                           value="@ViewBag.CurrentFilter" style="height: 46px" />
                    <button type="submit" class="btn btn-edit">
                        <i class="fas fa-search"></i> Search
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    }
                </div>
            </div>
        </div>
    </form>

    <div class="row d-flex justify-content-center">

        @if (!Model.Any())
        {
            <h1 class="text-danger d-flex justify-content-center">item not found</h1>
        }
        else
        {
              @foreach (var album in Model)
        {
            <div class="col-lg-3 col-md-4">
                <div class="album-card h-100 shadow-sm" style="background-color: #1b001b; color: white;">

                    <div class="album-image-container">


                        <img src="@album.ImageURL" class="card-img-top" alt="@album.Title" style="height: 500px;  object-fit: cover;">
                        @* <div class="album-content">
                            <h5 class="card-title">@album.Title</h5>
                            <p class="card-text">@album.Description</p>
                            <p class="text-muted">Released: @album.CreatedDate</p>
                        </div> *@

                        <div class="album-content">
                            <h4 class="album-title">@album.Title</h4>

                            <p class="album-description">
                                @album.Description
                            </p>

                            <div class="album-buttons">
                                <a asp-action="Index" asp-controller="Songs"                               asp-route-id="@album.Id"
                                   class="btn btn-view">
                                    View Songs
                                </a>

                              
                            </div>
                        </div>

                        </div>
                       @*  <div class="card-footer text-center">
                            <a asp-action="Details" asp-route-id="@album.Id" class="btn btn-sm btn-light">View</a>
                            <a asp-action="Edit" asp-route-id="@album.Id" class="btn btn-sm btn-secondary">Edit</a>
                             <a asp-action="Delete" asp-route-id="@album.Id" class="btn btn-sm btn-danger">Delete</a>
                            <a asp-action="Index" asp-controller="Songs" asp-route-id="@album.Id" class="btn btn-sm btn-light"></a>
                        </div> *@

                    </div>


                   


                </div>
          
        }
   
        }


    </div>





</div>



