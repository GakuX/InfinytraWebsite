@model dynamic

@{
    ViewData["Title"] = "Index";
}

<div class="container py-4 text-white">
    <h1>Your Cart</h1>
    <a asp-controller="Merches" asp-action="Index"><span class="btn btn-danger text-white">Continue shopping?</span> </a>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-dark mt-3">
            Cart is empty.
        </div>
    }
    else
    {
        <div class="mt-3">
            @foreach (var item in Model)
            {
                <div class="card mb-3 p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@item.Merch.ItemName</strong><br />
                            Qty: @item.Qty
                        </div>
                        <div>
                            $
                            @{
                                decimal unit = item.Merch.Price;

                                if (item.Merch.OnSale && item.Merch.SalePrice.HasValue)
                                {
                                    unit = item.Merch.SalePrice.Value;
                                }

                                decimal line = unit * item.Qty;
                            }
                            @line
                        </div>
                    </div>
                </div>
            }
        </div>

        <h3>Total: $@ViewBag.Total</h3>
    }
</div>