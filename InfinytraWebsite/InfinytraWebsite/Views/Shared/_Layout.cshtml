<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InfinytraWebsite</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InfinytraWebsite.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
          integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!--Style CSS-->
    <link rel="stylesheet" type="text/css" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800&display=swap" rel="stylesheet">


</head>
<body >
    <header>
        <!-- Add Bootstrap sticky-top so header sticks to top when scrolling -->
        <nav class="navbar navbar-expand-lg navbar-dark band-nav border-bottom sticky-top" style="z-index:1030;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-uppercase" asp-controller="Home" asp-action="Index">
                    <img src="~/images/infinytraremastered.png" width="150" height="93" style="padding-bottom: "/>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse shadow-text buttonfonts" id="mainNav">
                    <ul class="navbar-nav ms-auto gap-lg-3">
                        <li class="nav-item" style="color:black">
                            <a style="color:white; font-size:20px; font-weight:bold;" class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a style="color:white;font-size:20px;font-weight:bold;" class="nav-link" asp-controller="Albums" asp-action="Index">Albums</a>
                        </li>
                        <li class="nav-item">
                            <a style="color:white;font-size:20px;font-weight:bold; ; " class="nav-link" asp-controller="Members" asp-action="Index">Band Members</a>
                        </li>
                        <li class="nav-item">
                            <a style="color:white;font-size:20px;font-weight:bold; ; " class="nav-link" asp-controller="Merches" asp-action="Index">Merch</a>
                        </li>
                        <li class="nav-item">
                            <a href="https://discord.gg/3qstsyPE" style="color:white;font-size:20px;font-weight:bold; " class="nav-link">Discord</a>
                        </li>

                        <li class="nav-item">
                            <a href="https://www.instagram.com/" style="color:white;font-size:20px;font-weight:bold;  " class="nav-link" @* asp-controller="Members" asp-action="Index" *@>Instagram</a>
                        </li>
                        <li class="nav-item">
                            <a style="color:white;font-size:20px;font-weight:bold; ; "  class="nav-link" asp-controller="Members" asp-action="Index">News & Tours</a>
                        </li>
                        
                    </ul>
                </div>
            </div>
        </nav>

    </header>
    <div class="container-fluid px-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid band-title2 ps-4" >
            &copy; 2025 - Infinytra
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
