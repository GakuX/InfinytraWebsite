@model InfinytraWebsite.Models.Merch

@{
    ViewData["Title"] = "Details";
}

<div class="container-fluid py-4" style="background-color:white" >

    <div class="row">


        <div class="col-12 col-lg-6" style="padding-left:250px">
            <img src="@Model.ImageURL" style=" border-color:black; width:700px"/>
        </div>

        <div class="col-12 col-lg-6" style="padding-right:100px">

            <h1>@Model.ItemName</h1>
            <br />
            <h4>@Model.ItemDescription</h4>
            <br />
            <h2 style="font-weight:bold">$@Model.SalePrice</h2>
              <br />
              <h2>Size</h2>
                <br />
                
                    
            @if (@Model.InStock)
            {
                <h2>Availability IN STOCK</h2>
            }
            else
            {
                <h2><span style="font-weight:bold">Availability</span> <span style="color:red; font-size:25px">OUT OF STOCK</span> </h2>
            }

            <br />

        @*     <div class="d-flex align-items-center gap-3">
               

                    <form asp-controller="Carts" asp-action="Add" method="post" >
                        <input type="hidden" name="id" value="@Model.Id" />
