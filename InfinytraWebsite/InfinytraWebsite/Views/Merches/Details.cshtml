                    <button type="submit" class="btn btn-sm btn-dark">
                        <i class="fa-solid fa-cart-shopping" style="padding-right:7px"></i>
                        Add to cart
                    </button>

                    </form>
                

                </div> *@


            <div class="d-flex align-items-center gap-4">
                <form asp-controller="Carts"
                      asp-action="Add"
                      method="post"
                      class="d-flex align-items-center gap-4 m-0">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <input type="number"
                           class="form-control"
                           style="width:80px"
                           value="1"
                           min="1"
                           name="qty" />
                    
                    @if (Model.InStock)
                    {
                          <button type="submit" class="btn btn-sm btn-dark">
                        <i class="fa-solid fa-cart-shopping me-1"></i>
                        Add to cart
                        </button>
                    }else
                    {
                         <button type="button" class="btn btn-danger" disabled>UNAVAILABLE</button>

                    }


                </form>
            </div>

                    
               
        <div class="" >
                    <form asp-controller="Carts" asp-action="Add" method="post">

                        <input type="hidden" name="id" value="@Model.Id" />
                      
                    </form>
        </div>


        <br />
        <div>

                <a asp-controller="Merches" asp-action="Index"><button class="btn btn-dark">go back</button></a>
        </div>
        
           
            </div>


              
                    
           
        </div>


    </div>


</div>


