            </div>

            <br />

            <h2 class="border-bottom-text " style="font-weight:bold">Filters</h2>


            <br />

            <select class="row-2" id="fruits" name="fruits" style="width:254px;height:40px; border:none">
                <option value="" disabled selected style="font-weight:bold"> <strong>Price</strong></option>
                <option value="apple">0.00-24.99$</option>
              
                <option value="cherry">24.99-50.99$</option>
                  <option value="cherry">50.99-109.99$</option>
                <option value="cherry">109.99-299.99$</option>
            </select>

            <select class="row-2" id="fruits" name="fruits" style="width:254px;height:40px; border:none">
