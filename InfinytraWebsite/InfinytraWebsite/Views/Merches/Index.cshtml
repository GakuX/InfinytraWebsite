@model IEnumerable<InfinytraWebsite.Models.Merch>

@{
    ViewData["Title"] = "Index";
}







<br />

<div class="container-fluid">


    <div class="row g-4 ">

        <div class="col-12 col-lg-3 " style="background-color: white; border-radius:20px ">
             
            <br />

        
            <form  asp-action="Index" method="get">


                <h2 class="border-bottom-text " style="font-weight:bold">Categories</h2>
                <br />

                <input name="q" class="form-control mb-3" placeholder="Search..." style="width:250px;  " value="@ViewBag.Q" />
                <div class="col">


                    <select name="category" class="form-select mb-2" style="width:254px;height:40px;">
                        <option value="">All Categories</option>
                        <option value="Shirt">Shirt</option>
                        <option value="Album">Album</option>
                        <option value="Accessories">Accessories</option>
                        <option value="Collections">Collections</option>
                        <option value="Album Special">Album special</option>
                    </select>

                    @* <select class="" id="fruits" name="category" style="width: 254px; height:40px; border:none ">
                        <option value="Media" disabled selected>Media</option>

                    </select>

                    <br />


                    <select class="row-2" id="fruits" name="category" style="width:254px;height:40px; border:none">
                        <option value="Apparel" disabled selected>Apparel</option>

                    </select>

                    <br />


                    <select class="row-2" id="fruits" name="category" style="width:254px;height:40px; border:none">
                        <option value="Accessories" disabled selected>Accessories</option>

                    </select>


                    <br />


                    <select class="row-2" id="fruits" name="category" style="width:254px;height:40px; border:none">
                        <option value="Collections" disabled selected>Collections</option>

                    </select>

                    <br />


                    <select class="row-2" id="fruits" name="category" style="width:254px;height:40px; border:none">
                        <option value="Album Special" disabled selected>ALbum special</option>

                    </select> *@



                </div>

                <br />

                <h2 class="border-bottom-text " style="font-weight:bold">Filters</h2>


                <br />

                <select name="price" class="row-2 form-select" id="fruits" style="width:254px;height:40px; border:none">
                    <option value="Price" disabled selected style="font-weight:bold"> <strong>Price</strong></option>
               
                    <option value="0-25">Under $25</option>
                @*     <option value="0-10">Under $10</option> *@
                    <option value="25-50">$25 - $50</option>
                    <option value="50-999">$50+</option>

                </select>

                <select class="row-2 form-select mb-2" id="fruits" name="gender" style="width:254px;height:40px; border:none">
                    <option value="" disabled selected style="font-weight:bold"> <strong>Gender</strong></option>
                    <option value="Male">Male</option>

                    <option value="Female">Female</option>
                </select>

                <h1></h1>
                <h1></h1>
                <h1></h1>

            

                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" name="inStockOnly" value="true" id="inStockOnly" />
                    <label class="form-check-label" for="inStockOnly">In stock only</label>
                </div>

                <div class="form-check mt-2">
                    <input type="checkbox" class="form-check-input" name="onSaleOnly" value="true"  />
                    <label class="form-check-label" for="onSaleOnly">On sale only</label>
                </div>
              
                <div class="d-flex gap-2 mt-3"style="padding-top:10px">
                    <button type="submit" class="btn btn-dark btn-sm">Apply</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>

                <br />
                <br />


            </form>

        </div>

         
           




        <div class="col-12 col-lg-9 ">


            <div class="container py-4">


                <h1 style="color: white">Merch</h1>

                <div class="row g-4">

                    
                    @if (!Model.Any())
                    {
                        <h1> item not found</h1>
                    }else
                    {
                         @foreach (var item in Model)
                    {
                       
                             <div class="col-12 col-sm-6 col-lg-4 col-xl-3">


                            <div class="card h-100 w-100 d-flex flex-column">

                                <div class="">
                                    <img src="@item.ImageURL" class="card-img-top" style="height:180px; object-fit:cover;" />
                                </div>



                                <div class=" card-body ">

                                    <div>
                                        @if (item.NewItem)
                                        {
                                            <h1 style="color:red; font-weight:bold; font-size:30px;">NEW</h1>
                                        }
                                        else
                                        {
                                            <h1 style="color:red; font-size: 30px; font-weight:bold">ALMOST GONE</h1>
                                        }


                                        @if (!item.InStock)
                                        {
                                            <span class="badge bg-danger">Sold Out</span>
                                        }
                                        else
                                        {
                                            <span>.</span>
                                        }


                                    </div>




                                    <div style="padding-top: 5px">

                                        <h5 class="card-title">@item.ItemName</h5>


                                            @if (item.OnSale && item.SalePrice.HasValue)
                                            {
                                                <div class="d-flex">
                                                @*     <div class="col-4">
                                                        <p class="text-decoration-line-through mb-1 fw-bold"> </p>
                                                    </div>
                                                    
                                                    <div class="col-4">
                                                        <p style="color: red; font-weight:bold; font-size:17px "></p>
                                                    </div>
                                                    <div class="col-4"></div> *@


                                                    <span class="text-decoration-line-through fw-bold text-muted">$@item.Price</span>

                                                    <span class="fw-bold text-danger" style="font-size:17px; padding-left:10px">ONLY $@item.SalePrice.Value</span>
                                                </div>
                                                 

                                                 

                                            }else
                                            {
                                                <p class="mb-1 fw-bold">$@item.Price</p>
                                            }

                                      





                                        <p class="small text-muted" style="padding-top:5px">@item.Categories</p>
                                    </div>

                                    <div class=" bg-transparent border-0 ">
                                        <a class="btn btn-sm btn-dark"
                                           asp-action="Details"
                                           asp-route-id="@item.Id">Item Details</a>
                                    </div>
                                </div>


                            </div>

                            </div>

                        
                        



                    }
                    }


                   

                </div>

            </div>

          






        </div>
    </div>
    </div>







