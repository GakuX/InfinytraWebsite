                <option value="apple">Male</option>

                <option value="cherry">Female</option>
            </select>

           <h1></h1>
            <h1></h1>
            <h1></h1>
           



        </div>




        <div class="col-12 col-lg-9 ">


            <div class="container py-4">


                <h1 style="color: white">Merch</h1>

                <div class="row g-4">
                    @foreach (var item in Model)
                    {



                        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">


                            <div class="card h-100 w-100 d-flex flex-column">

                                <div class="">
                                    <img src="@item.ImageURL" class="card-img-top" style="height:180px; object-fit:cover;" />
                                </div>



                                <div class=" card-body ">

                                    <div>
                                        @if (item.NewItem)
                                        {
                                            <h1 style="color:red; font-weight:bold; font-size:30px;">NEW</h1>
                                        }
                                        else
                                        {
                                            <h1 style="color:red; font-size: 30px; font-weight:bold">ALMOST GONE</h1>
                                        }


                                        @if (!item.InStock)
                                        {
                                            <span class="badge bg-danger">Sold Out</span>
                                        }
                                        else
                                        {
                                            <span>.</span>
                                        }


                                    </div>




                                    <div style="padding-top: 5px">

                                        <h5 class="card-title">@item.ItemName</h5>
                                        <p class="mb-1 fw-bold">$@item.Price</p>
                                        <p class="small text-muted">@item.Categories</p>
                                    </div>

                                    <div class=" bg-transparent border-0 ">
                                        <a class="btn btn-sm btn-dark"
                                           asp-action="Details"
                                           asp-route-id="@item.Id">Item Details</a>
                                    </div>
                                </div>


                            </div>

                        </div>
                    }

                </div>

            </div>

          






        </div>
    </div>
    </div>


