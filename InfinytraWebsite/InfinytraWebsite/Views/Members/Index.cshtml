@model IEnumerable<InfinytraWebsite.Models.Member>

@{
    // ViewData["Title"] = "Band Members";
    ViewData["BodyClass"] = "members-body-bg";
}


<body class="members-body-bg">

    <div class="">
        <div class="container py-5">
            <h1 class="text-center text-white mb-4">Band Members</h1>



            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-12 col-sm-6 col-md-3 d-flex align-items-stretch">
                        <div class="card profile-card member-bg w-100 p-3 d-flex flex-row align-items-start"
                             @* style="background-image: url('@item.ImageURL'); " *@ >

                            <img class="avatar" src="@item.PhotoURL" alt="@item.Name" />

                            <div class="profile-body ms-3">
                                <h5 class="profile-name mb-1">@item.Name</h5>

                                <p style="font-weight: bold; padding-top: 10px;">@item.Role</p>

                                <p style="font-weight: bold;
                                /*   text-shadow: 0 0 10px rgba(160, 0, 255, 0.6),
                                               0 0 20px rgba(160, 0, 255, 0.4); */">
                                    @item.Description
                                </p>


                                <div class="card profilebutton mt-3">
                               

                                    <a asp-controller="Members"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-light">
                                        Details
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>

                }
            </div>



